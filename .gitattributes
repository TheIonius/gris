# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Force Unix LF for scripts and code
*.sh text eol=lf
*.java text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.py text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf

# Windows scripts CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.db binary
*.db-shm binary
*.db-wal binary
*.jar binary
*.war binary
